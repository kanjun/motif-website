---
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { inline, parseQuotes, parseSketches } from '../lib/library';

const quotesPage = await getEntry('pages', 'quotes');
const notesPage = await getEntry('pages', 'notes');
const groups = parseQuotes(quotesPage?.body ?? '');
const assets = Object.fromEntries(
  Object.entries(import.meta.glob<{ default: ImageMetadata }>('../assets/images/*', { eager: true })).map(
    ([path, mod]) => [path.split('/').pop()!, mod.default],
  ),
);
const images = Object.fromEntries(Object.entries(assets).map(([name, img]) => [name, img.src]));
const { intro, sketches: parsed } = parseSketches(notesPage?.body ?? '', images);
// Small thumbnails for the grid (the drawings are half a megabyte each); the full drawing opens on click.
const sketches = await Promise.all(parsed.map(async (s) => {
  const file = Object.keys(images).find((name) => images[name] === s.image);
  const thumb = file ? (await getImage({ src: assets[file], width: 640, format: 'webp' })).src : s.image;
  return { ...s, thumb };
}));

const toc = [
  ...groups.map((g, i) => ({ id: g.id, label: g.title, count: g.quotes.length, sub: i > 0 })),
  ...(sketches.length ? [{ id: 'sketches', label: 'Sketches', count: sketches.length }] : []),
];
---

<BaseLayout title="Library ∙ Kanjun Qiu" description="Quotes and passages I found striking, and sketches I drew while learning." section="library" toc={toc} wide>
  <h1 class="title">Library</h1>
  <p class="content">Collected snippets and sketches.</p>

  {groups.map((g, i) => (
    <>
      {i === 0 ? <h2 class="section-title" id={g.id}>{g.title}</h2> : <h3 class="subsection" id={g.id}>{g.title}</h3>}
      <div class="cards">
        {g.quotes.map((q) => (
          <div class="card" {...(import.meta.env.DEV ? { "data-edit-file": "pages/quotes", "data-edit-find": q.raw.slice(0, 40) } : {})}>
            <p class="quote" set:html={q.html} />
            <span class="label">{q.by}</span>
          </div>
        ))}
      </div>
    </>
  ))}

  {sketches.length > 0 && (
    <>
      <h2 class="section-title" id="sketches">Sketches</h2>
      <div class="content">
        {intro.split(/\n\s*\n/).map((p) => <p set:html={inline(p)} />)}
      </div>
      <div class="sketches">
        {sketches.map((s) => (
          <div class="sketch" {...(import.meta.env.DEV ? { "data-edit-file": "pages/notes", "data-edit-find": s.title } : {})}>
            <a href={s.image} class="zoom" data-title={s.title}><img src={s.thumb} alt={s.alt} width="640" height="480" /></a>
            <b>{s.title}</b>
            {s.html && <span class="sub" set:html={s.html} />}
          </div>
        ))}
      </div>
    </>
  )}
</BaseLayout>

<dialog class="lightbox" id="lightbox">
  <figure>
    <img alt="" />
    <figcaption class="label"></figcaption>
  </figure>
  <button type="button" class="close label" aria-label="Close">Close</button>
</dialog>

<script>
  // A sketch opens full size over the page; click anywhere or press Escape to close.
  const box = document.getElementById('lightbox') as HTMLDialogElement;
  document.querySelectorAll<HTMLAnchorElement>('a.zoom').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      box.querySelector('img')!.src = a.href;
      box.querySelector('img')!.alt = a.querySelector('img')?.alt ?? '';
      box.querySelector('figcaption')!.textContent = a.dataset.title ?? '';
      box.showModal();
    });
  });
  box.addEventListener('click', () => box.close());
</script>
