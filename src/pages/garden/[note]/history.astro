---
import { getCollection, getEntry } from 'astro:content';
import GardenLayout from '../../../layouts/GardenLayout.astro';
import { diffWords, simpleMarkdown } from '../../../lib/diff';

export async function getStaticPaths() {
  const histories = await getCollection('gardenHistory');
  return histories.filter((h) => h.data.versions.length > 1).map((h) => ({ params: { note: h.id } }));
}

const slug = Astro.params.note!;
const note = await getEntry('garden', slug);
const history = await getEntry('gardenHistory', slug);
const versions = history!.data.versions;
const when = (d: Date) =>
  d.toLocaleString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/Los_Angeles' });
---

<GardenLayout title={`History of ${note!.data.title} ∙ Kanjun Qiu`}>
  <article class="pane pane-solo" data-slug={`${slug}/history`} data-title={`History of ${note!.data.title}`}>
    <div class="pane-body">
      <div class="note content">
        <p class="history-back"><a href={`/garden/${slug}`} data-no-stack>← {note!.data.title}</a></p>
        <h1 class="title">History</h1>
        {versions.map((v, i) => (
          <details class="version" open={i === 0}>
            <summary>{when(v.date)}{i === 0 ? ' · current' : ''}{i === versions.length - 1 ? ' · first published' : ''}</summary>
            <div class="version-text" set:html={simpleMarkdown(i < versions.length - 1 ? diffWords(versions[i + 1].text, v.text) : v.text)} />
          </details>
        ))}
      </div>
    </div>
  </article>
</GardenLayout>
