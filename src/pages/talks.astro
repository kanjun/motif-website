---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { inline } from '../lib/library';

// Built from talks.md: each talk is "## [YEAR | Title](link)" followed by its embed.
const page = await getEntry('pages', 'talks');
const body = page?.body ?? '';
const [introPart, ...parts] = body.split(/^##\s+/m);
const talks = parts.map((part) => {
  const [heading, ...rest] = part.split('\n');
  const m = heading.match(/^\[(.+?)\]\(([^)]+)\)/);
  const text = m ? m[1] : heading;
  const [year, ...titleBits] = text.split('|');
  const embed = rest.join('\n').trim();
  const src = embed.match(/src="([^"]+)"/)?.[1] ?? '';
  const youtube = src.match(/youtube(?:-nocookie)?\.com\/embed\/([\w-]+)/)?.[1];
  return {
    year: titleBits.length ? year.trim() : '',
    title: (titleBits.length ? titleBits.join('|') : text).trim(),
    url: m?.[2],
    src,
    thumb: youtube ? `https://i.ytimg.com/vi/${youtube}/hqdefault.jpg` : '',
    audio: /spotify|soundcloud|podcast/.test(src),
  };
});
---

<BaseLayout title={page?.data.pageTitle ?? 'Talks ∙ Kanjun Qiu'} description={page?.data.description} section="talks" wide>
  <h1 class="title">Talks</h1>
  <div class="content">
    {introPart.trim().split(/\n\s*\n/).map((p) => <p set:html={inline(p)} />)}
  </div>
  <div class="talks">
    {talks.map((t) => (
      <div class:list={['talk', { audio: t.audio }]} {...(import.meta.env.DEV ? { 'data-edit-file': 'pages/talks', 'data-edit-find': t.title } : {})}>
        {/* A still with a play button; the player loads only when clicked. Pages
            stay light, and the editor's preview never starts a player. */}
        <button class="embed" type="button" data-src={t.src} data-audio={t.audio ? '1' : undefined}
          style={t.thumb ? `background-image:url(${t.thumb})` : undefined} aria-label={`Play: ${t.title}`}>
          <span class="play label">{t.audio ? 'Listen' : 'Play'}</span>
        </button>
        {/* Date and title under the video, so videos in a row line up whatever the title's length. */}
        <span class="label">{t.year}</span>
        {t.url ? <a class="talk-title" href={t.url}>{t.title}</a> : <span class="talk-title">{t.title}</span>}
      </div>
    ))}
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.talk .embed').forEach((button) => {
    button.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      const src = button.dataset.src!;
      frame.src = src + (src.includes('youtube') ? (src.includes('?') ? '&' : '?') + 'autoplay=1' : '');
      frame.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture';
      frame.allowFullscreen = true;
      // Without this YouTube can't tell which site embeds it and shows a configuration error.
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.className = button.dataset.audio ? 'player audio' : 'player';
      button.replaceWith(frame);
    });
  });
</script>
