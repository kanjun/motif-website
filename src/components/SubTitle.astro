---
interface Props {
  date: string;
  authorName?: string;
  authorUrl?: string;
}

const { date, authorName, authorUrl } = Astro.props;
---

<p class="text-zinc-500 text-base !mt-0 !mb-2" style="font-style: italic;">
  {authorName ? (
    <>
      {date}, with <a class="text-zinc-500 font-normal hover:text-zinc-700" href={authorUrl}>{authorName}</a>
    </>
  ) : (
    date
  )}
</p>
