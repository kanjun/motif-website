---
import Header from '../components/Header.astro';
import '../styles/site.css';
import '../styles/garden.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Kanjectures: Kanjun Qiu’s working notes.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="shortcut icon" href="/images/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300..800;1,300..800&family=DM+Mono:wght@400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..600;1,8..60,400..600&display=swap" rel="stylesheet" />
  </head>
  <body class="garden-page">
    <Header section="kanjectures" />
    <div class="stack" id="stack">
      <slot />
    </div>
    <div class="popover" id="popover" hidden></div>
    <script>
      import { startGarden } from '../lib/garden-client';
      startGarden();
    </script>
  </body>
</html>
