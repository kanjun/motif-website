---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    date?: string;
    description?: string;
    ogImage?: string;
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout
  title={`${frontmatter.title} ∙ Kanjun Qiu`}
  description={frontmatter.description}
  ogImage={frontmatter.ogImage}
  section="essays"
>
  <article>
    {frontmatter.date && <span class="label" style="display:block;margin-bottom:var(--space-4)">{frontmatter.date}</span>}
    <h1 class="title">{frontmatter.title}</h1>
    <div class="content">
      <slot />
    </div>
  </article>
</BaseLayout>
