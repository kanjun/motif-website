---
import Header from '../components/Header.astro';
import '../styles/site.css';
// The draft phone layout shows in the editor's preview only, never on the live site.
import phoneDraft from '../styles/phone-draft.css?raw';
import '../styles/tufte-sidenotes.css';

export interface TocItem {
  id: string;
  label: string;
  count?: number;
  sub?: boolean;
}

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  // Which section of the top bar to underline.
  section?: 'essays' | 'kanjectures' | 'talks' | 'library';
  // An "On this page" list beside the page, one entry per section heading.
  toc?: TocItem[];
  wide?: boolean;
}

const {
  title,
  description = "Kanjun Qiu - Writing, Kanjectures, Notes, Bookshelf.",
  ogImage = "/images/favicon.png",
  section,
  toc = [],
  wide = false,
} = Astro.props;

// Link previews need a full address, so expand site-relative image paths.
const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary" />
    <link rel="shortcut icon" href="/images/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300..800;1,300..800&family=DM+Mono:wght@400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..600;1,8..60,400..600&display=swap" rel="stylesheet" />
    <!-- Littlefoot for mobile footnote hover -->
    <link rel="stylesheet" href="https://unpkg.com/littlefoot/dist/littlefoot.css" />
  </head>
  <body>
    <Header section={section} />
    <div class="page">
      <main class:list={['page-main', { wide }]}>
        <slot />
      </main>
      {toc.length > 0 && (
        <aside class="toc">
          {toc.map((item, i) => (
            <a href={`#${item.id}`} class:list={[{ sub: item.sub, on: i === 0 }]} data-toc={item.id}>
              <b>{item.label}</b>{item.count !== undefined && <span>{item.count}</span>}
            </a>
          ))}
        </aside>
      )}
    </div>

    <script>
      // The contents list underlines the section you are reading.
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a[data-toc]')];
      if (links.length) {
        const targets = links.map((a) => document.getElementById(a.dataset.toc!)).filter(Boolean) as HTMLElement[];
        const update = () => {
          let current = targets[0];
          for (const t of targets) if (t.getBoundingClientRect().top < window.innerHeight * 0.3) current = t;
          links.forEach((a) => a.classList.toggle('on', a.dataset.toc === current?.id));
        };
        window.addEventListener('scroll', update, { passive: true });
        update();
      }
    </script>
    <script>
      import littlefoot from 'littlefoot';
      // Only activate littlefoot on mobile (sidenotes become footnotes)
      if (window.innerWidth < 768) {
        littlefoot({ activateOnHover: true, hoverDelay: 100 });
      }
    </script>
    {/* Last in the page so it wins over the preview's own styles. */}
    {import.meta.env.DEV && <style is:inline set:html={phoneDraft} />}
  </body>
</html>
